<Window
    x:Class="GameFocus.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameFocus.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GameFocus">

    <Grid>
        <NavigationView x:Name="NavView" 
                        Loaded="NavView_Loaded"
                        ItemInvoked="NavView_ItemInvoked"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Auto">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Dashboard" Icon="Home" Content="Dashboard" />
                <NavigationViewItem Tag="Library" Icon="Library" Content="Library" />
                <NavigationViewItem Tag="History" Icon="Clock" Content="History" />
                <NavigationViewItem Tag="Goals" Icon="Target" Content="Goals" />
                <NavigationViewItem Tag="Coach" Icon="ContactInfo" Content="GameFocus Coach" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="24" />
        </NavigationView>
    </Grid>
</Window>
