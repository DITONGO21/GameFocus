<Page
    x:Class="GameFocus.UI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:GameFocus.Core.Entities"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="0,0,16,0">
        <StackPanel Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="Session history" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="A record of all the time you have invested." 
                           Style="{StaticResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ListView ItemsSource="{Binding Sessions, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="entities:GameSession">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StartTimeUtc, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EndTimeUtc, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationSeconds, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="You have no recorded sessions yet." 
                       Foreground="{ThemeResource TextFillColorDisabledBrush}"
                       Visibility="{Binding HasSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
        </StackPanel>
    </Grid>
</Page>
