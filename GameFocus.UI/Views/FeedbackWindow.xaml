<Window
    x:Class="GameFocus.UI.Views.FeedbackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GameFocus - Feedback">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Did you enjoy the session?" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="😡" FontSize="20" ToolTipService.ToolTip="Não Gostei" Grid.Column="0" Click="BtnNaoGostei_Click"/>
                <Button Content="😐" FontSize="20" ToolTipService.ToolTip="Neutro" Grid.Column="1" Click="BtnNeutro_Click"/>
                <Button Content="🙂" FontSize="20" ToolTipService.ToolTip="Gostei" Grid.Column="2" Click="BtnGostei_Click"/>
                <Button Content="🤩" FontSize="20" ToolTipService.ToolTip="Adorei" Grid.Column="3" Click="BtnAdorei_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
